# CodeSentinel — Environment Configuration
# Copy this file to .env and configure variables as needed.

# Application Server Port (default: 3000)
PORT=3000

# Node Environment ('development' | 'production')
NODE_ENV=development

# Google Gemini AI API Key (Optional)
# Required only for the optional Gemini-powered Security Copilot.
# When omitted, CodeSentinel utilizes its deterministic, rule-based SAST advisory engine.
GEMINI_API_KEY=""

# Application URL (Optional)
APP_URL="http://localhost:3000"
